---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const packages = [
  {
    pkg: "password",
    deps: "x/crypto",
    title: "Passwords",
    body: "Argon2id by default, or PBKDF2-HMAC-SHA256 with 600,000 iterations. Unknown identifiers spend the same work as real ones.",
    href: `${base}/guides/password/`,
  },
  {
    pkg: "session",
    deps: "stdlib",
    title: "Server-side sessions",
    body: "Idle and absolute lifetimes, a <code>__Host-</code> cookie, rotation on login and revocation on logout.",
    href: `${base}/guides/sessions/`,
  },
  {
    pkg: "totp",
    deps: "stdlib",
    title: "TOTP",
    body: "Six-digit RFC 6238 codes as a second factor. Each code is consumed once per enrollment.",
    href: `${base}/guides/totp/`,
  },
  {
    pkg: "webauthn",
    deps: "go-webauthn",
    title: "WebAuthn and passkeys",
    body: "Security keys and passkeys as a second factor, and opt-in passkey sign-in without a username.",
    href: `${base}/guides/webauthn/`,
  },
  {
    pkg: "oidc",
    deps: "go-oidc · oauth2",
    title: "OpenID Connect",
    body: "Sign in with a configured issuer and get a verified external identity to link to a local account.",
    href: `${base}/guides/oidc/`,
  },
  {
    pkg: "mcpoauth",
    deps: "stdlib",
    title: "MCP OAuth",
    body: "An OAuth 2.1 authorization server and bearer token verifier for one MCP server, with PKCE and rotating refresh tokens.",
    href: `${base}/guides/mcp-oauth/`,
  },
];

// From the design: what the packages enforce, and what stays with the application.
const enforced = [
  "Password checks in constant time, with dummy work for unknown identifiers",
  "Server-side validation of every session",
  "Secure, HttpOnly, host-only session cookies",
  "Revocation on logout and on refresh token reuse",
  "Single-use, 60-second authorization codes bound to PKCE",
];
const owned = [
  "Identifier normalization, enrollment rules and account lifecycle",
  "Authorization and the decision to require MFA",
  "Throttling, CSRF protection and HTTPS",
  "Account recovery and consent screens",
  "The database schema and shared stores",
];

const next = [
  { n: "01", title: "Installation", href: `${base}/getting-started/installation/` },
  { n: "02", title: "Quickstart", href: `${base}/getting-started/quickstart/` },
  { n: "03", title: "Sessions", href: `${base}/guides/sessions/` },
  { n: "04", title: "MCP OAuth", href: `${base}/guides/mcp-oauth/` },
];
---

<section class="gh-sec not-content" aria-labelledby="gh-feat-title">
  <p class="gh-kicker">Packages</p>
  <h2 id="gh-feat-title">Import only what the app uses</h2>
  <ul class="gh-feat">
    {
      packages.map((f) => (
        <li>
          <span class="gh-feat-head">
            <span class="gh-feat-pkg">{f.pkg}</span>
            <span class="gh-feat-deps">{f.deps}</span>
          </span>
          <h3>{f.title}</h3>
          <p set:html={f.body} />
          <a href={f.href}>
            {f.title}
            <span class="sr-only"> guide</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<section class="gh-sec not-content" aria-labelledby="gh-own-title">
  <p class="gh-kicker">Design</p>
  <h2 id="gh-own-title">The packages verify. The app decides.</h2>
  <div class="gh-own">
    <div>
      <h3>Authlume enforces</h3>
      <ul>{enforced.map((e) => <li>{e}</li>)}</ul>
    </div>
    <div>
      <h3>The application owns</h3>
      <ul>{owned.map((e) => <li>{e}</li>)}</ul>
    </div>
  </div>
  <p class="gh-note">
    A session is issued only when the application calls <code>Issue</code> after its login policy is complete.
    <a href={`${base}/reference/design/`}>Read the design</a>
  </p>
</section>

<nav class="gh-sec gh-next not-content" aria-labelledby="gh-next-title">
  <p class="gh-kicker">Start here</p>
  <h2 id="gh-next-title">Read in this order</h2>
  <ol>
    {
      next.map((s) => (
        <li>
          <a href={s.href}>
            <span class="gh-next-n">{s.n}</span>
            <span class="gh-next-t">{s.title}</span>
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<footer class="gh-foot not-content">
  <span class="gh-foot-name" translate="no">github.com/i2bskn/authlume</span>
  <ul>
    <li><a href="https://docs.i2bskn.com/">All docs</a></li>
    <li><a href="https://github.com/i2bskn/authlume">GitHub</a></li>
    <li><a href="https://github.com/i2bskn/authlume/blob/main/LICENSE">MIT License</a></li>
  </ul>
</footer>

<style>
  .gh-sec {
    padding-block: 4rem 1rem;
    border-top: 1px solid var(--sl-color-hairline);
  }
  .gh-kicker {
    margin: 0 0 0.75rem;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gh-accent-text);
  }
  h2 {
    max-width: 36rem;
    margin: 0;
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }

  .gh-feat {
    display: grid;
    gap: 1px;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--gh-line);
    border-radius: var(--gh-radius);
    background: var(--gh-line);
    overflow: clip;
  }
  @media (min-width: 40rem) {
    .gh-feat {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 72rem) {
    .gh-feat {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .gh-feat li {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.5rem 1.4rem 1.4rem;
    background: var(--sl-color-black);
  }
  .gh-feat-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .gh-feat-pkg {
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--gh-accent-text);
  }
  .gh-feat-deps {
    padding: 0 0.5rem;
    border: 1px solid var(--gh-line);
    border-radius: 999px;
    font-size: var(--sl-text-2xs);
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }
  .gh-feat h3 {
    margin: 0.25rem 0 0;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
  }
  .gh-feat p {
    flex: 1;
    margin: 0;
    font-size: var(--sl-text-sm);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }
  .gh-feat p :global(code) {
    font-family: var(--__sl-font-mono);
    font-size: 0.8125rem;
    color: var(--sl-color-gray-1);
  }
  .gh-feat a {
    align-self: flex-start;
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    color: var(--sl-color-white);
    text-decoration: underline;
    text-decoration-color: var(--sl-color-accent);
    text-underline-offset: 0.25em;
  }
  .gh-feat a:hover {
    color: var(--gh-accent-text);
  }
  .gh-note {
    margin: 1.25rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .gh-note code {
    font-family: var(--__sl-font-mono);
    font-size: 0.8125rem;
    color: var(--sl-color-gray-2);
  }
  .gh-note a {
    margin-left: 0.25rem;
    color: var(--sl-color-gray-2);
    text-decoration-color: var(--sl-color-accent);
    text-underline-offset: 0.22em;
  }
  .gh-note a:hover {
    color: var(--gh-accent-text);
  }
  .gh-own {
    display: grid;
    gap: 1rem;
    margin: 2.5rem 0 0;
  }
  @media (min-width: 48rem) {
    .gh-own {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .gh-own > div {
    padding: 1.4rem 1.4rem 1.5rem;
    border: 1px solid var(--gh-line);
    border-radius: var(--gh-radius);
    background: var(--gh-surface);
  }
  .gh-own > div:first-child {
    border-color: color-mix(in srgb, var(--sl-color-accent) 45%, var(--gh-line));
  }
  .gh-own h3 {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .gh-own ul {
    display: grid;
    gap: 0.55rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .gh-own li {
    position: relative;
    padding-left: 1.1rem;
    font-size: var(--sl-text-sm);
    line-height: 1.55;
    color: var(--sl-color-gray-2);
  }
  .gh-own li::before {
    content: "";
    position: absolute;
    top: 0.6em;
    left: 0;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--gh-line);
  }
  .gh-own > div:first-child li::before {
    background: var(--sl-color-accent);
  }

  .gh-entries {
    display: grid;
    margin: 2.5rem 0 0;
    border-top: 1px solid var(--gh-line);
  }
  .gh-entries > div:last-child {
    border-bottom: 0;
  }
  .gh-entries > div {
    display: grid;
    gap: 0.35rem 2rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--gh-line);
  }
  @media (min-width: 48rem) {
    .gh-entries > div {
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
      align-items: baseline;
    }
  }
  .gh-entries dt code {
    font-family: var(--__sl-font-mono);
    font-size: 0.875rem;
    color: var(--sl-color-white);
    overflow-wrap: anywhere;
  }
  .gh-entries dd :global(code) {
    font-family: var(--__sl-font-mono);
    font-size: 0.8125rem;
    white-space: nowrap;
  }
  .gh-entries dd {
    margin: 0;
    font-size: var(--sl-text-sm);
    line-height: 1.55;
    color: var(--sl-color-gray-2);
  }

  .gh-next {
    padding-bottom: 4rem;
  }
  .gh-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1.5rem 0.5rem;
    border-top: 1px solid var(--sl-color-hairline);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .gh-foot-name {
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
  }
  .gh-foot-name span {
    margin-left: 0.4rem;
    color: var(--sl-color-gray-3);
  }
  .gh-foot ul {
    display: flex;
    gap: 0.5rem 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .gh-foot a {
    display: inline-block;
    padding-block: 0.8rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .gh-foot a:hover {
    color: var(--gh-accent-text);
  }
  .gh-next ol {
    display: grid;
    gap: 0.75rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) {
    .gh-next ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 72rem) {
    .gh-next ol {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .gh-next a {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--gh-line);
    border-radius: var(--gh-radius);
    background: var(--gh-surface);
    color: var(--sl-color-white);
    text-decoration: none;
    transition: border-color 160ms ease;
  }
  .gh-next a:hover,
  .gh-next a:focus-visible {
    border-color: var(--sl-color-accent);
  }
  .gh-next-n {
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--gh-accent-text);
  }
  .gh-next-t {
    flex: 1;
    font-weight: 500;
  }
  .gh-next svg {
    color: var(--sl-color-gray-3);
    transition: transform 160ms ease;
  }
  .gh-next a:hover svg {
    transform: translateX(3px);
    color: var(--gh-accent-text);
  }
</style>
