---
// A keyhole in a ring of light: authentication (auth) that the application can see through (lume).
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="gh-title" translate="no">
  <svg class="gh-mark" viewBox="0 0 28 28" width="28" height="28" aria-hidden="true">
    <circle cx="14" cy="14" r="11.75" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <circle cx="14" cy="11.75" r="2.6" class="gh-mark-key"></circle>
    <path d="M12.6 13.6 11.9 19.25h4.2L15.4 13.6Z" class="gh-mark-key"></path>
  </svg>
  <span class="gh-name">authlume<span class="gh-scope"> docs</span></span>
</a>

<style>
  .gh-title {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .gh-mark {
    flex: none;
    color: var(--sl-color-white);
  }
  .gh-mark-key {
    fill: var(--sl-color-accent);
  }
  .gh-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--__sl-font-mono);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .gh-scope {
    color: var(--sl-color-gray-3);
  }
  @media (max-width: 30rem) {
    .gh-scope {
      display: none;
    }
  }
</style>
